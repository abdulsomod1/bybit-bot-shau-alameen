# ============================================================
# BYBIT P2P BOT — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# ----- Supabase -----
# Get these from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ----- Frontend Build Variables (VITE_ prefix exposes to React) -----
# These are embedded at build time — must be set when building the frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ----- Encryption Key -----
# Generate a secure random 32-byte key for AES-256-GCM encryption.
# Run this to generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RENDER_SERVICE_ENCRYPTION_KEY=generate-a-64-char-hex-string-here

# ----- Render -----
# Set in Render dashboard → Your Web Service → Environment
PORT=3000
NODE_ENV=production

# ----- Optional -----
# Log level (info, warn, error)
LOG_LEVEL=info