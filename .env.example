# ============================================================
# BYBIT P2P BOT — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# ----- Supabase -----
# Get these from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ----- Frontend Build Variables (VITE_ prefix exposes to React) -----
# These are embedded at build time — must be set when building the frontend.
# For production: build with NODE_ENV=production and VITE_API_BASE_URL=/api
# (use /api for same-origin deployment where Express serves both API + frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# API base URL for HTTP API calls. Use /api for same-origin production deployment.
# In development, this defaults to the Vite proxy target.
VITE_API_BASE_URL=

# ----- Encryption Key -----
# Generate a secure random 32-byte key for AES-256-GCM encryption.
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RENDER_SERVICE_ENCRYPTION_KEY=generate-a-64-char-hex-string-here

# ----- Owner Access Token -----
# REQUIRED: A secret string that protects the API from unauthorized access.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# In development, you can also set OWNER_ACCESS_TOKEN_DEV as a fallback.
# NEVER commit this to Git. Set in Render dashboard environment variables.
OWNER_ACCESS_TOKEN=your-secret-owner-access-token-here
OWNER_ACCESS_TOKEN_DEV=dev-owner-token (change this!)

# ----- Render -----
# Set in Render dashboard → Your Web Service → Environment
PORT=3000
NODE_ENV=production

# ----- Bot Worker -----
# Polling interval in milliseconds (default: 60000 = 1 minute)
BOT_POLL_INTERVAL=60000

# ----- Optional -----
# Log level (info, warn, error)
LOG_LEVEL=info
