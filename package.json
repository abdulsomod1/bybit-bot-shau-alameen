{
  "name": "bybit-p2p-bot",
  "version": "1.0.0",
  "description": "Professional Bybit P2P Advertisement Management Bot",
  "main": "dist/main/main/main.js",
  "type": "module",
  "author": "Bybit P2P Bot",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:main && npm run build:preload && concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload && npm run build:server",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:server": "tsc -p tsconfig.server.json",
    "build:preload": "tsc -p src/preload/tsconfig.json",
    "start": "node dist/server/index.js",
    "electron:dev": "concurrently -k \"npm run dev:vite\" \"npm run electron:start\"",
    "electron:start": "wait-on http://localhost:5173 && electron .",
    "electron:build": "npm run build && electron-builder --win --config electron-builder.json",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "check-env": "node check-env.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "chalk": "^4.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "node-fetch": "^2.7.0",
    "sql.js": "^1.12.0",
    "uuid": "^11.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-log": "^5.2.4",
    "electron-store": "^10.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  }
}